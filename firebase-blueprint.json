{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "HH Mineral Water bottle products in catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "size": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "image": { "type": "string", "maxLength": 2000000 },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDesc": { "type": "string", "maxLength": 500 },
        "inStock": { "type": "boolean" },
        "isVisible": { "type": "boolean" },
        "minOrderQty": { "type": "number" },
        "category": { "type": "string", "maxLength": 100 },
        "badge": { "type": "string", "maxLength": 100 },
        "casePackSize": { "type": "number" },
        "customDesignPrice": { "type": "number" },
        "gstRate": { "type": "number" },
        "hsnCode": { "type": "string", "maxLength": 20 },
        "discountPercent": { "type": "number" },
        "stockCount": { "type": "number" },
        "stockStatus": { "type": "string", "maxLength": 50 },
        "version": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 100 },
        "updatedBy": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "name", "size", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer bottle order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 100 },
        "paymentStatus": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 50 },
        "dispatchQrCode": { "type": "string", "maxLength": 128 },
        "dispatchVerifiedAt": { "type": "string", "maxLength": 64 },
        "dispatchVerifiedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "createdAt", "totalAmount", "status"]
    },
    "ProductAuditLog": {
      "title": "ProductAuditLog",
      "description": "Audit record of product edits by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 200 },
        "changedField": { "type": "string", "maxLength": 100 },
        "oldValue": { "type": "string", "maxLength": 5000 },
        "newValue": { "type": "string", "maxLength": 5000 },
        "adminEmail": { "type": "string", "maxLength": 200 },
        "adminName": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 100 },
        "deviceInfo": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "productId", "changedField", "timestamp"]
    },
    "User": {
      "title": "User",
      "description": "Customer profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 100 },
        "addresses": { "type": "array" }
      },
      "required": ["uid"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "GST Tax Invoices for bottle orders",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 128 },
        "orderId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "grandTotal": { "type": "number" },
        "status": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "invoiceNumber", "orderId", "grandTotal"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store operational and visual settings",
      "type": "object",
      "properties": {
        "ownerWhatsApp": { "type": "string", "maxLength": 50 },
        "helplinePhone": { "type": "string", "maxLength": 50 },
        "contactEmail": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "freeDeliveryMinAmount": { "type": "number" },
        "defaultDeliveryCharge": { "type": "number" },
        "acceptingOrders": { "type": "boolean" },
        "orderPrefix": { "type": "string", "maxLength": 50 },
        "businessName": { "type": "string", "maxLength": 200 },
        "gstin": { "type": "string", "maxLength": 50 },
        "fssaiNumber": { "type": "string", "maxLength": 50 },
        "showAllProducts": { "type": "boolean" },
        "hiddenProductIds": { "type": "array" },
        "showSellingPrice": { "type": "boolean" },
        "showDiscountPercentage": { "type": "boolean" },
        "factoryStaffPin": { "type": "string", "maxLength": 20 }
      }
    },
    "AiTask": {
      "title": "AiTask",
      "description": "Autonomous AI task execution record synchronized with Master AI Orchestrator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 64 },
        "agentName": { "type": "string", "maxLength": 120 },
        "eventSource": { "type": "string", "maxLength": 240 },
        "taskDescription": { "type": "string", "maxLength": 600 },
        "authorizationLevel": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 40 },
        "verificationStatus": { "type": "string", "maxLength": 40 },
        "tokensUsed": { "type": "number" },
        "startedAt": { "type": "string", "maxLength": 100 },
        "completedAt": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "agentId", "agentName", "status", "createdAt"]
    },
    "AiAgentMessage": {
      "title": "AiAgentMessage",
      "description": "Cross-agent communication handoff, alert, and verification report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "correlationId": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "fromAgentId": { "type": "string", "maxLength": 64 },
        "fromAgentName": { "type": "string", "maxLength": 120 },
        "toAgentId": { "type": "string", "maxLength": 64 },
        "toAgentName": { "type": "string", "maxLength": 120 },
        "intent": { "type": "string", "maxLength": 40 },
        "subject": { "type": "string", "maxLength": 300 },
        "status": { "type": "string", "maxLength": 40 },
        "priority": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "correlationId", "fromAgentId", "toAgentId", "intent", "subject", "createdAt"]
    },
    "AiApproval": {
      "title": "AiApproval",
      "description": "Owner approval request generated by AI specialists for sensitive operations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "taskId": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 64 },
        "agentName": { "type": "string", "maxLength": 120 },
        "actionType": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 1000 },
        "expectedImpact": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 40 },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "agentId", "actionType", "title", "status", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global product catalog with real-time sync across all devices"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store customer orders"
    },
    "/product_audit_logs/{logId}": {
      "schema": "ProductAuditLog",
      "description": "Audit trail of all product edits by administrators"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Customer profiles and addresses"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "GST Tax Invoices for orders"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Global store settings"
    },
    "/ai_tasks/{taskId}": {
      "schema": "AiTask",
      "description": "Master AI Orchestrator task execution logs (Admin only)"
    },
    "/ai_agent_messages/{messageId}": {
      "schema": "AiAgentMessage",
      "description": "Persistent specialist-to-specialist communication bus (Admin only)"
    },
    "/ai_approvals/{approvalId}": {
      "schema": "AiApproval",
      "description": "Owner approval queue for sensitive Level 3 AI operations (Admin only)"
    }
  }
}
