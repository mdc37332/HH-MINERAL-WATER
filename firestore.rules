rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: Publicly readable by all customer & admin devices; writeable by app/admin
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: Creatable by customers & guests, readable for order tracking and admin
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Product Audit Logs: Full trail of product changes
    match /product_audit_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: if true;
      allow write: if true;
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles & addresses
    match /users/{userId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
