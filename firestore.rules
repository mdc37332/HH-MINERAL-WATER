rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token &&
         request.auth.token.email_verified == true && (
          request.auth.token.email.lower() == 'mdhussain170707@gmail.com' ||
          request.auth.token.email.lower() == 'mdc37332@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Entity Validation Blueprints ---
    function isValidProduct(data) {
      return (!('id' in data) || (data.id is string && isValidId(data.id))) &&
             (!('name' in data) || (data.name is string && data.name.size() > 0 && data.name.size() <= 200)) &&
             (!('size' in data) || (data.size is string && data.size.size() <= 50)) &&
             (!('isVisible' in data) || data.isVisible is bool) &&
             (!('price' in data) || (data.price is number && data.price >= 0));
    }

    function isValidOrder(data) {
      return (!('id' in data) || (data.id is string && isValidId(data.id))) &&
             (!('totalAmount' in data) || (data.totalAmount is number && data.totalAmount >= 0)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidInvoice(data) {
      return (!('id' in data) || (data.id is string && isValidId(data.id))) &&
             (!('orderId' in data) || (data.orderId is string && isValidId(data.orderId))) &&
             (!('grandTotal' in data) || (data.grandTotal is number && data.grandTotal >= 0));
    }

    function isValidProductAuditLog(data) {
      return (!('id' in data) || (data.id is string && isValidId(data.id))) &&
             (!('productId' in data) || (data.productId is string && data.productId.size() <= 128)) &&
             (!('changedField' in data) || (data.changedField is string && data.changedField.size() <= 100));
    }

    function isValidStoreSettings(data) {
      return (!('ownerWhatsApp' in data) || (data.ownerWhatsApp is string && data.ownerWhatsApp.size() <= 50)) &&
             (!('hiddenProductIds' in data) || (data.hiddenProductIds is list && data.hiddenProductIds.size() <= 200)) &&
             (!('freeDeliveryMinAmount' in data) || data.freeDeliveryMinAmount is number);
    }

    function isValidAiTask(data) {
      return data.id is string && isValidId(data.id) &&
             data.agentId is string && data.agentId.size() > 0 && data.agentId.size() <= 64 &&
             data.agentName is string && data.agentName.size() > 0 && data.agentName.size() <= 120 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 40 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('eventSource' in data) || (data.eventSource is string && data.eventSource.size() <= 240)) &&
             (!('taskDescription' in data) || (data.taskDescription is string && data.taskDescription.size() <= 600)) &&
             (!('authorizationLevel' in data) || (data.authorizationLevel is string && data.authorizationLevel.size() <= 64)) &&
             (!('verificationStatus' in data) || (data.verificationStatus is string && data.verificationStatus.size() <= 40)) &&
             (!('tokensUsed' in data) || (data.tokensUsed is number && data.tokensUsed >= 0));
    }

    function isValidAiAgentMessage(data) {
      return data.id is string && isValidId(data.id) &&
             data.correlationId is string && data.correlationId.size() > 0 && data.correlationId.size() <= 128 &&
             data.fromAgentId is string && data.fromAgentId.size() > 0 && data.fromAgentId.size() <= 64 &&
             data.toAgentId is string && data.toAgentId.size() > 0 && data.toAgentId.size() <= 64 &&
             data.intent is string && data.intent.size() > 0 && data.intent.size() <= 40 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 300 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('fromAgentName' in data) || (data.fromAgentName is string && data.fromAgentName.size() <= 120)) &&
             (!('toAgentName' in data) || (data.toAgentName is string && data.toAgentName.size() <= 120)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 40)) &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 20));
    }

    function isValidAiApproval(data) {
      return data.id is string && isValidId(data.id) &&
             data.agentId is string && data.agentId.size() > 0 && data.agentId.size() <= 64 &&
             data.actionType is string && data.actionType.size() > 0 && data.actionType.size() <= 64 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.status is string && data.status.size() > 0 && data.status.size() <= 40 &&
             data.createdAt is string && data.createdAt.size() <= 100 &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 1000)) &&
             (!('expectedImpact' in data) || (data.expectedImpact is string && data.expectedImpact.size() <= 1000));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Products collection: Publicly readable; strictly validated write
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Orders collection: Publicly readable for tracking & live catalog; strictly validated create and update
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && (
        isAdmin() || isValidOrder(incoming())
      );
      allow delete: if isValidId(orderId) || isAdmin();
    }

    // Product Audit Logs: Full trail of product changes
    match /product_audit_logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidProductAuditLog(incoming());
      allow update, delete: if isValidId(logId) || isAdmin();
    }

    // Invoices collection: Order GST invoices
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create, update: if isValidId(invoiceId) && isValidInvoice(incoming());
      allow delete: if isValidId(invoiceId) || isAdmin();
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isValidStoreSettings(incoming());
    }

    // User profiles & addresses: Strictly secured to authenticated owner or admin without self-privilege escalation
    match /users/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create: if isValidId(userId) && (
        (isOwner(userId) && (!('role' in incoming()) || incoming().role == 'customer')) ||
        isAdmin()
      );
      allow update: if isValidId(userId) && (
        (isOwner(userId) && (!('role' in incoming()) || (('role' in existing()) && incoming().role == existing().role) || incoming().role == 'customer')) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Master AI Orchestrator Tasks (Admin Only)
    match /ai_tasks/{taskId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(taskId) && isValidAiTask(incoming());
      allow delete: if isAdmin() && isValidId(taskId);
    }

    // Cross-Agent Communication Bus (Admin Only)
    match /ai_agent_messages/{messageId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(messageId) && isValidAiAgentMessage(incoming());
      allow delete: if isAdmin() && isValidId(messageId);
    }

    // Owner Approval Requests Queue (Admin Only)
    match /ai_approvals/{approvalId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isValidId(approvalId) && isValidAiApproval(incoming());
      allow delete: if isAdmin() && isValidId(approvalId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if isValidId(docId);
    }
  }
}
